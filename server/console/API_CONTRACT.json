{
  "_meta": {
    "baseUrl": "process.env.REACT_APP_API_URL  →  e.g. http://localhost:4040/api",
    "auth": "Protected routes require header: Authorization: Bearer <token>",
    "tokenStorage": "localStorage.getItem('token')  →  full 'Bearer eyJ...' string",
    "buildAuthHeader": "{ Authorization: `Bearer ${localStorage.getItem('token')}`, 'Content-Type': 'application/json' }",
    "accessLevelHierarchy": ["default", "create", "tutor", "quality", "manage", "admin", "root"],
    "tutorRankHierarchy": ["assistant", "teacher", "lecturer", "instructor", "tutor", "professor"],
    "notes": [
      "user.role stored in localStorage is a plain string (accessLevel), e.g. 'admin', 'create', 'tutor'",
      "tutorRank is a separate field on the user, used for session rank gating",
      "Chats use token from Authorization header extracted manually — same Bearer format",
      "SSE streams require token as QUERY PARAM: ?token=<full-bearer-string-from-localStorage>"
    ]
  },

  "AUTH": {
    "login": {
      "method": "POST",
      "url": "/auth/login",
      "access": "public",
      "body": { "email": "user@example.com", "password": "secret123" },
      "response_200": { "token": "eyJhbGci...", "tokenType": "Bearer" },
      "note": "Decode JWT payload to extract role.accessLevel for local storage"
    },
    "register": {
      "method": "POST",
      "url": "/auth/register",
      "access": "public",
      "body": { "email": "user@example.com", "password": "secret123", "nickname": "alice" },
      "response_201": "{ full user document }"
    },
    "validate": {
      "method": "POST",
      "url": "/auth/validate",
      "access": "Bearer",
      "body": {},
      "response_200": { "valid": true },
      "note": "Checks token validity and access level"
    },
    "extendSession": {
      "method": "POST",
      "url": "/auth/ext-session",
      "access": "Bearer",
      "body": { "data": "{ any user data object }" },
      "response_200": { "token": "eyJhbGci...", "tokenType": "Bearer" }
    }
  },

  "USERS": {
    "getCurrent": {
      "method": "GET",
      "url": "/users/c",
      "access": "Bearer",
      "response_200": {
        "user": {
          "_id": "...",
          "nickname": "alice",
          "email": "alice@example.com",
          "role": { "_id": "...", "roleName": "admin", "accessLevel": "admin" },
          "tutorRank": null,
          "courses": [{ "_id": "courseId", "process": 0.5 }],
          "links": []
        }
      }
    },
    "getAll": {
      "method": "GET",
      "url": "/users",
      "access": "public (token optional)",
      "query": {
        "search": "optional — filters by nickname or email",
        "tutorOnly": "true — returns only users with tutorRank set"
      },
      "response_200": { "data": ["...array of user objects..."] }
    },
    "getById": {
      "method": "GET",
      "url": "/users/:id",
      "access": "public",
      "response_200": { "data": "{ user object }" }
    },
    "create": {
      "method": "POST",
      "url": "/users",
      "access": "admin+",
      "body": { "email": "bob@example.com", "password": "secret123", "nickname": "bob", "role": "roleObjectId" },
      "response_201": {
        "message": "User created successfully",
        "login": { "email": "bob@example.com", "password": "secret123" },
        "data": "{ full user document }"
      }
    },
    "update": {
      "method": "PATCH",
      "url": "/users/:id",
      "access": "admin+",
      "body": {
        "nickname": "bob2", "firstName": "Bob", "lastName": "Smith",
        "email": "bob@example.com", "phone": "+380...", "github": "bobsmith",
        "role": "roleObjectId", "password": "newpass (optional)",
        "tutorRank": "instructor", "courses": []
      },
      "response_200": { "message": "User updated successfully", "data": "{ updated user }" }
    },
    "delete": {
      "method": "DELETE",
      "url": "/users/:id",
      "access": "admin+",
      "response_200": { "message": "User deleted successfully", "data": { "_id": "..." } }
    },
    "updateCourseProgress": {
      "method": "PATCH",
      "url": "/users/me/courses/:courseId/progress",
      "access": "Bearer",
      "body": { "process": 0.65 },
      "response_200": { "message": "Progress updated", "data": { "process": 0.65 } },
      "note": "process must be 0–1. Progress never decreases — ignored if new value is lower than current."
    },
    "finishCourse": {
      "method": "PATCH",
      "url": "/users/me/courses/:courseId/finish",
      "access": "Bearer",
      "body": {},
      "response_200": { "message": "Course marked as finished", "data": { "process": 1 } }
    },
    "getProfilePicture": {
      "method": "GET",
      "url": "/users/:id/profile-picture/:filename",
      "access": "public",
      "response": "Binary image file"
    },
    "uploadProfilePicture": {
      "method": "POST",
      "url": "/users/:id/profile-picture",
      "access": "manage+",
      "body": "multipart/form-data — field: 'avatar' (image file)",
      "response_200": { "message": "Profile picture uploaded successfully", "data": { "userId": "...", "filename": "avatar.jpg", "link": { "url": "/api/files/users/:id/avatar.jpg" } } }
    },
    "updateProfilePicture": {
      "method": "PUT",
      "url": "/users/:id/profile-picture",
      "access": "manage+",
      "body": "multipart/form-data — field: 'avatar' (image file)",
      "response_200": { "message": "Profile picture updated successfully", "data": { "userId": "...", "filename": "avatar.jpg", "link": {} } }
    },
    "deleteProfilePicture": {
      "method": "DELETE",
      "url": "/users/:id/profile-picture",
      "access": "manage+",
      "response_200": { "message": "Profile picture deleted successfully", "data": { "userId": "..." } }
    }
  },

  "COURSES": {
    "getAll": {
      "method": "GET",
      "url": "/courses",
      "access": "public",
      "response_200": { "data": ["...array of course objects..."] }
    },
    "getById": {
      "method": "GET",
      "url": "/courses/:id",
      "access": "public",
      "response_200": { "data": "{ full course object }" }
    },
    "create": {
      "method": "POST",
      "url": "/courses",
      "access": "create+",
      "body": {
        "title": "My Course", "description": "...", "direction": "Web Development",
        "level": "Beginner", "price": 0, "courseType": "SELF_TAUGHT",
        "base_lang": "en", "add_langs": [], "trans": [], "skills": []
      },
      "response_201": { "message": "Course created successfully", "data": "{ course }" }
    },
    "update": {
      "method": "PATCH",
      "url": "/courses/:id",
      "access": "create+",
      "body": "Same fields as create, send only changed fields",
      "response_200": { "message": "Course updated successfully", "data": "{ updated course }" }
    },
    "delete": {
      "method": "DELETE",
      "url": "/courses/:id",
      "access": "create+",
      "response_200": { "message": "Course deleted successfully", "data": { "_id": "..." } }
    },
    "getMyRating": {
      "method": "GET",
      "url": "/courses/:id/rating",
      "access": "Bearer",
      "response_200": {
        "data": { "courseId": "...", "avgRating": 4.2, "totalVotes": 18, "myRating": 5 }
      },
      "note": "myRating is null if the user hasn't rated yet"
    },
    "rateById": {
      "method": "POST",
      "url": "/courses/:id/rating",
      "access": "Bearer (must own the course)",
      "body": { "value": 4 },
      "response_200": { "data": { "avgRating": 4.2, "totalVotes": 19, "myRating": 4 } },
      "note": "value must be integer 1–5"
    },
    "purchase": {
      "method": "POST",
      "url": "/courses/:id/purchase",
      "access": "Bearer",
      "body": { "promoCode": "SAVE20 (optional)" },
      "response_200": {
        "message": "Course purchased successfully",
        "data": { "courseId": "...", "finalPrice": 0 }
      },
      "note": "Returns 200 'Already owned' if user already has the course. HOSTED courses return 400."
    },
    "getComments": {
      "method": "GET",
      "url": "/courses/:id/comments",
      "access": "public",
      "response_200": { "data": ["...array of comment objects..."] }
    },
    "addComment": {
      "method": "POST",
      "url": "/courses/:id/comments",
      "access": "Bearer",
      "body": { "text": "Great course!" },
      "response_201": { "data": "{ comment object }" }
    },
    "deleteComment": {
      "method": "DELETE",
      "url": "/courses/:id/comments/:commentId",
      "access": "Bearer (own comment or manage+)",
      "response_200": { "message": "Comment deleted" }
    },
    "listCourseFiles": {
      "method": "GET",
      "url": "/courses/:id/files",
      "access": "public",
      "response_200": { "files": ["...array of file objects with url, filename, originalName..."] }
    },
    "getCourseFile": {
      "method": "GET",
      "url": "/courses/:id/files/:filename",
      "access": "public",
      "response": "Binary file stream"
    },
    "uploadCourseFile": {
      "method": "POST",
      "url": "/courses/:id/files",
      "access": "create+",
      "body": "multipart/form-data — field: 'file'",
      "response_200": { "message": "File uploaded", "data": { "filename": "...", "url": "..." } }
    },
    "uploadCourseFiles": {
      "method": "POST",
      "url": "/courses/:id/files/multiple",
      "access": "create+",
      "body": "multipart/form-data — field: 'files' (multiple)",
      "response_200": { "message": "Files uploaded", "data": ["..."] }
    },
    "deleteCourseFile": {
      "method": "DELETE",
      "url": "/courses/:id/files/:filename",
      "access": "create+",
      "response_200": { "message": "File deleted" }
    }
  },

  "DIRECTIONS": {
    "getAll": { "method": "GET", "url": "/directions", "access": "public", "response_200": { "data": ["..."] } },
    "getById": { "method": "GET", "url": "/directions/:id", "access": "public", "response_200": { "data": "{ direction }" } },
    "create": { "method": "POST", "url": "/directions", "access": "manage+", "body": { "name": "Web Development" }, "response_201": { "data": "{ direction }" } },
    "update": { "method": "PUT", "url": "/directions/:id", "access": "manage+", "body": { "name": "Updated Name" }, "response_200": { "data": "{ direction }" } },
    "delete": { "method": "DELETE", "url": "/directions/:id", "access": "manage+", "response_200": { "message": "Deleted" } }
  },

  "LEVELS": {
    "getAll": { "method": "GET", "url": "/levels", "access": "public", "response_200": { "data": ["..."] } },
    "getById": { "method": "GET", "url": "/levels/:id", "access": "public", "response_200": { "data": "{ level }" } },
    "create": { "method": "POST", "url": "/levels", "access": "manage+", "body": { "name": "Beginner" }, "response_201": { "data": "{ level }" } },
    "update": { "method": "PUT", "url": "/levels/:id", "access": "manage+", "body": { "name": "Updated" }, "response_200": { "data": "{ level }" } },
    "delete": { "method": "DELETE", "url": "/levels/:id", "access": "manage+", "response_200": { "message": "Deleted" } }
  },

  "ROLES": {
    "note": "Managed via /manage route — requires manage+ access"
  },

  "KEYS": {
    "listAll": {
      "method": "GET", "url": "/keys", "access": "manage+",
      "response_200": { "data": ["...array of key objects..."] }
    },
    "generate": {
      "method": "POST", "url": "/keys", "access": "manage+",
      "body": { "courseIds": ["..."], "amount": 1, "note": "optional", "expiresAt": "ISO date (optional)" },
      "response_201": { "message": "1 key(s) generated", "data": ["...array of key objects..."] }
    },
    "deleteKey": {
      "method": "DELETE", "url": "/keys/:id", "access": "manage+",
      "response_200": { "message": "Key deleted", "data": { "_id": "..." } }
    },
    "redeem": {
      "method": "POST", "url": "/keys/redeem", "access": "Bearer",
      "body": { "code": "XXXX-XXXX-XXXX" },
      "response_200": { "message": "Key redeemed", "data": { "courseId": "..." } }
    },
    "getMyKeys": {
      "method": "GET", "url": "/keys/mine", "access": "Bearer",
      "response_200": { "data": ["...array of keys redeemed by current user..."] }
    }
  },

  "PROMOS": {
    "listAll": { "method": "GET", "url": "/promos", "access": "create+", "response_200": { "data": ["..."] } },
    "create": {
      "method": "POST", "url": "/promos", "access": "create+",
      "body": { "code": "SAVE20", "courseIds": ["..."], "discountType": "percent", "discountValue": 20, "maxUses": 100, "expiresAt": "ISO date", "note": "" },
      "response_201": { "message": "Promo created", "data": { "_id": "...", "code": "SAVE20" } }
    },
    "toggle": {
      "method": "PATCH", "url": "/promos/:id/toggle", "access": "create+",
      "response_200": { "message": "Promo enabled/disabled", "data": { "active": true } }
    },
    "delete": { "method": "DELETE", "url": "/promos/:id", "access": "create+", "response_200": { "message": "Promo deleted", "data": { "_id": "..." } } },
    "validate": {
      "method": "POST", "url": "/promos/validate", "access": "Bearer",
      "body": { "code": "SAVE20", "courseId": "..." },
      "response_200": { "valid": true, "discount": 20, "discountType": "percent", "finalPrice": 80 },
      "response_200_invalid": { "valid": false, "reason": "This promo has expired" }
    },
    "apply": {
      "method": "POST", "url": "/promos/apply", "access": "Bearer",
      "body": { "code": "SAVE20", "courseId": "..." },
      "response_200": { "message": "Promo applied", "data": { "finalPrice": 80 } }
    }
  },

  "SESSIONS": {
    "getAll": {
      "method": "GET",
      "url": "/sessions",
      "access": "tutor+ (tutors see own; manage+ sees all)",
      "response_200": { "data": ["...array of session objects with populated course/tutors..."] }
    },
    "getById": {
      "method": "GET",
      "url": "/sessions/:id",
      "access": "tutor+ (must be host or co-tutor; manage+ unrestricted)",
      "response_200": { "data": "{ full session object }" }
    },
    "create": {
      "method": "POST",
      "url": "/sessions",
      "access": "tutor+",
      "body": {
        "courseId": "64b5c987e...",
        "courseType": "HOSTED",
        "coTutors": [{ "userId": "...", "canGrade": true, "canSchedule": true, "canEditCopy": false }],
        "restrictionIgnored": false
      },
      "response_201": { "message": "Session created", "data": "{ session object }" },
      "note": "courseType defaults to the course's own courseType. restrictionIgnored requires manage+ to take effect."
    },
    "update": {
      "method": "PATCH",
      "url": "/sessions/:id",
      "access": "host tutor or manage+",
      "body": {
        "status": "active",
        "schedule": [{ "title": "Lecture 1", "datetime": "2026-04-01T18:00:00.000Z", "durationMin": 90, "meetingLink": "https://...", "notes": "", "isRecurring": false }],
        "deadlines": [{ "targetType": "chapter", "targetId": "ch-001", "dueAt": "2026-04-15T23:59:59.000Z", "lockAfterDue": false }],
        "coTutors": [{ "userId": "...", "canGrade": true, "canSchedule": true, "canEditCopy": false }],
        "copyEditAllowed": false,
        "courseType": "HOSTED"
      },
      "response_200": { "message": "Session updated", "data": "{ updated session }" },
      "note": "Send only fields you want to change."
    },
    "delete": {
      "method": "DELETE",
      "url": "/sessions/:id",
      "access": "host tutor or manage+",
      "note": "Session must have status 'completed' before deletion.",
      "response_200": { "message": "Session permanently deleted", "data": { "_id": "...", "groupsDeleted": 2 } }
    },
    "archive": {
      "method": "PATCH",
      "url": "/sessions/:id/archive",
      "access": "host tutor or manage+",
      "body": {},
      "response_200": { "message": "Session archived", "data": { "_id": "..." } }
    },
    "createPrivateCopy": {
      "method": "POST",
      "url": "/sessions/:id/private-copy",
      "access": "host tutor (or co-tutor with canEditCopy) or manage+",
      "body": {},
      "response_201": { "message": "Private copy created (3 file(s) copied)", "data": { "privateCopyId": "..." } }
    },
    "overrideRank": {
      "method": "POST",
      "url": "/sessions/:id/override-rank",
      "access": "host tutor or manage+",
      "body": { "tutorId": "userId of tutor to override" },
      "response_200": { "message": "Rank restriction overridden for tutor ..." }
    },
    "revokeRankOverride": {
      "method": "POST",
      "url": "/sessions/:id/revoke-rank-override",
      "access": "host tutor or manage+",
      "body": { "tutorId": "userId of tutor" },
      "response_200": { "message": "Rank override revoked for tutor ..." }
    },
    "getExpandedSchedule": {
      "method": "GET",
      "url": "/sessions/:id/schedule/expanded",
      "access": "tutor+ in session",
      "response_200": { "data": ["...expanded recurring events as individual occurrences..."] }
    },
    "prune": {
      "method": "POST",
      "url": "/sessions/prune",
      "access": "manage+",
      "body": { "olderThanDays": 90, "statuses": ["archived", "completed"] },
      "response_200": { "message": "Pruned N session(s)" }
    }
  },

  "GROUPS": {
    "getBySession": {
      "method": "GET",
      "url": "/groups?sessionId=:sessionId",
      "access": "tutor in session or manage+",
      "response_200": { "data": ["...array of group objects with populated members and assignments..."] }
    },
    "getMyGroups": {
      "method": "GET",
      "url": "/groups/my",
      "access": "Bearer",
      "response_200": { "data": ["...groups where current user is a member..."] },
      "note": "Use this to find which sessions a student belongs to. Returns groups with sessionId populated."
    },
    "getById": {
      "method": "GET",
      "url": "/groups/:id",
      "access": "tutor in session, member of group, or manage+",
      "response_200": { "data": "{ full group object }" }
    },
    "create": {
      "method": "POST",
      "url": "/groups",
      "access": "tutor in session or manage+",
      "body": { "sessionId": "...", "name": "Group A" },
      "response_201": { "message": "Group created", "data": "{ group }" }
    },
    "delete": {
      "method": "DELETE",
      "url": "/groups/:id",
      "access": "host tutor or manage+",
      "response_200": { "message": "Group deleted", "data": { "_id": "..." } }
    },
    "addMember": {
      "method": "POST",
      "url": "/groups/:id/members",
      "access": "tutor in session or manage+",
      "body": { "emailOrNickname": "student@example.com" },
      "response_200": { "message": "alice added to group", "data": { "userId": "...", "nickname": "alice" } }
    },
    "updateMemberStatus": {
      "method": "PATCH",
      "url": "/groups/:id/members/:userId/status",
      "access": "tutor in session or manage+",
      "body": { "status": "active" },
      "note": "status: 'active' | 'dropped' | 'completed'",
      "response_200": { "message": "Member status updated" }
    },
    "removeMember": {
      "method": "DELETE",
      "url": "/groups/:id/members/:userId",
      "access": "tutor in session or manage+",
      "response_200": { "message": "Member removed from group" }
    }
  },

  "ASSIGNMENTS": {
    "getByGroup": {
      "method": "GET",
      "url": "/assignments?groupId=:groupId",
      "access": "tutor in session or manage+",
      "response_200": { "data": ["...array of assignment objects..."] }
    },
    "create": {
      "method": "POST",
      "url": "/assignments",
      "access": "tutor in session or manage+",
      "body": "multipart/form-data",
      "fields": {
        "sessionId": "string",
        "groupId": "string",
        "courseId": "string",
        "title": "string",
        "description": "string (optional)",
        "dueAt": "ISO datetime string",
        "markScale": "'5' | '12' | '100' | 'custom'",
        "maxMark": "number",
        "taskFiles": "file(s) — field name 'taskFiles' (array)"
      },
      "response_201": { "message": "Assignment created", "data": "{ assignment }" }
    },
    "update": {
      "method": "PATCH",
      "url": "/assignments/:id",
      "access": "tutor in session or manage+",
      "body": "multipart/form-data — same fields as create, all optional. Add 'removeFiles' as JSON array of filenames to remove.",
      "response_200": { "message": "Assignment updated", "data": "{ updated assignment }" }
    },
    "place": {
      "method": "PATCH",
      "url": "/assignments/:id/place",
      "access": "tutor in session or manage+",
      "body": { "type": "item", "targetId": "iid string" },
      "response_200": { "message": "Assignment placed in course content" }
    },
    "delete": {
      "method": "DELETE",
      "url": "/assignments/:id",
      "access": "tutor in session or manage+",
      "response_200": { "message": "Assignment deleted", "data": { "_id": "..." } }
    },
    "removeTaskFile": {
      "method": "DELETE",
      "url": "/assignments/:id/files/:filename",
      "access": "tutor in session or manage+",
      "response_200": { "message": "File removed" }
    },
    "getTaskFile": {
      "method": "GET",
      "url": "/assignments/files/:sessionId/:filename",
      "access": "Bearer",
      "response": "Binary file stream"
    }
  },

  "SUBMISSIONS": {
    "getSubmissions": {
      "method": "GET",
      "url": "/submissions/:groupId/:assignmentId",
      "access": "tutor in session or manage+",
      "response_200": { "data": ["...array of submission objects..."] }
    },
    "submit": {
      "method": "POST",
      "url": "/submissions/:groupId/:assignmentId",
      "access": "Bearer (student in group)",
      "body": "multipart/form-data — field: 'submission' (single file: .zip or .txt)",
      "response_201": { "message": "Submitted", "data": { "isOverdue": false } }
    },
    "grade": {
      "method": "PATCH",
      "url": "/submissions/:groupId/:assignmentId/:studentId/grade",
      "access": "tutor in session with canGrade, or manage+",
      "body": { "mark": 4, "feedback": "Good work!", "status": "approved" },
      "note": "status: 'approved' | 'declined'. Overdue penalty applied automatically.",
      "response_200": { "message": "Graded", "data": { "mark": 3, "status": "approved" } }
    },
    "downloadSubmission": {
      "method": "GET",
      "url": "/submissions/:groupId/:assignmentId/:studentId/file",
      "access": "tutor in session or manage+",
      "response": "Binary file stream (student's submitted file)"
    }
  },

  "FORMS": {
    "submitApplication": {
      "method": "POST",
      "url": "/forms/apply/:formType",
      "access": "public (Bearer optional — attaches userId if present)",
      "body": "multipart/form-data",
      "fields": {
        "data": "JSON string — { firstName, lastName, email, about, ... }",
        "skills": "JSON string — array of skill objects",
        "cert_0": "file — certificate for skills[0]",
        "example_0": "file — example file for skills[0]"
      },
      "formTypes": ["creator", "tutor", "support-ticket"],
      "response_201": { "message": "Submission received", "data": { "_id": "...", "status": "pending" } }
    },
    "getAll": {
      "method": "GET",
      "url": "/forms",
      "access": "quality+",
      "query": { "formType": "optional filter", "status": "pending|under-review|approved|rejected", "search": "text" },
      "response_200": { "count": 5, "data": ["...array of submission objects..."] }
    },
    "getByType": {
      "method": "GET",
      "url": "/forms/:formType",
      "access": "quality+",
      "query": { "status": "optional", "search": "optional" },
      "response_200": { "count": 3, "data": ["..."] }
    },
    "getOneById": {
      "method": "GET",
      "url": "/forms/detail/:id",
      "access": "quality+",
      "response_200": { "data": "{ full submission object }" }
    },
    "updateStatusById": {
      "method": "PATCH",
      "url": "/forms/detail/:id",
      "access": "quality+",
      "body": { "status": "approved", "reviewNote": "Looks good!" },
      "note": "status: 'pending' | 'under-review' | 'approved' | 'rejected'",
      "response_200": { "message": "Submission updated", "data": "{ updated submission }" }
    },
    "deleteById": {
      "method": "DELETE",
      "url": "/forms/detail/:id",
      "access": "quality+",
      "response_200": { "message": "Submission deleted" }
    },
    "noUserSubmissionsEndpoint": {
      "note": "There is NO endpoint to fetch a user's own past form submissions. The /forms routes are admin-only (quality+). Students cannot query their own submissions."
    }
  },

  "CHATS": {
    "auth_note": "Chats extract the token from Authorization header manually (no passport middleware). Pass the same 'Bearer ...' header as other routes.",
    "getAll": {
      "method": "GET",
      "url": "/chats",
      "access": "Bearer (extracts user from token)",
      "response_200": {
        "data": [{
          "_id": "...",
          "participants": [{ "_id": "...", "nickname": "alice", "firstName": "...", "lastName": "...", "links": [] }],
          "lastMessage": { "_id": "...", "text": "hello", "senderNickname": "alice", "senderId": "...", "createdAt": "..." },
          "lastActivity": "ISO date",
          "unread": 2
        }]
      }
    },
    "create": {
      "method": "POST",
      "url": "/chats",
      "access": "Bearer",
      "body": { "userId": "targetUserId" },
      "response_201": { "data": "{ populated chat object }" },
      "note": "Returns existing chat if one already exists between the two users."
    },
    "getById": {
      "method": "GET",
      "url": "/chats/:id",
      "access": "Bearer (must be participant)",
      "response_200": { "data": "{ chat object }" }
    },
    "delete": {
      "method": "DELETE",
      "url": "/chats/:id",
      "access": "Bearer (must be participant)",
      "response_200": { "message": "Chat deleted" }
    },
    "getMessages": {
      "method": "GET",
      "url": "/chats/:id/messages",
      "access": "Bearer (must be participant)",
      "query": { "limit": "1–100, default 50", "before": "message _id — for pagination" },
      "response_200": { "data": ["...messages in chronological order (oldest first)..."] }
    },
    "sendMessage": {
      "method": "POST",
      "url": "/chats/:id/messages",
      "access": "Bearer (must be participant)",
      "body": { "text": "Hello!" },
      "response_201": { "data": "{ populated message object }" }
    },
    "deleteMessage": {
      "method": "DELETE",
      "url": "/chats/:id/messages/:msgId",
      "access": "Bearer (must be participant and message sender)",
      "response_200": { "message": "Message deleted" }
    }
  },

  "FILES": {
    "note": "Course files served at /courses/:id/files/:filename. Profile pictures at /users/:id/profile-picture/:filename. Both are public GET endpoints."
  },

  "UTILS": {
    "getStatus": {
      "method": "GET",
      "url": "/utils/status",
      "access": "manage+",
      "response_200": { "data": { "userCount": 42, "courseCount": 10, "sessionCount": 5 } }
    },
    "statusStream": {
      "method": "GET",
      "url": "/utils/status/stream?token=<bearer-token-string>",
      "access": "manage+ via query param token",
      "note": "SSE stream. Token must be the full Bearer string from localStorage. NOT an Authorization header — use ?token= query param.",
      "response": "Server-Sent Events stream with status data"
    },
    "getLogs": {
      "method": "GET",
      "url": "/utils/logs",
      "access": "manage+",
      "query": { "date": "YYYY-MM-DD or 'today'", "lines": "number of lines" },
      "response_200": { "data": "log file content" }
    },
    "logsStream": {
      "method": "GET",
      "url": "/utils/logs/stream?token=<bearer-token-string>",
      "access": "manage+ via query param token",
      "note": "SSE stream. Same token rule as statusStream.",
      "response": "Server-Sent Events stream with live log lines"
    }
  },

  "KNOWN_BUGS_AND_CORRECTIONS": {
    "ViewCourse_finishCourse": {
      "wrong": "PATCH /users/me/courses/:id/finish",
      "correct": "PATCH /users/me/courses/:courseId/finish",
      "note": "Param name must be :courseId not :id"
    },
    "ViewCourse_updateProgress": {
      "endpoint": "PATCH /users/me/courses/:courseId/progress",
      "body": "{ process: 0.65 }",
      "note": "This endpoint DOES exist. Progress never decreases. Use this for incremental saves."
    },
    "SessionsArchive": {
      "wrong": "DELETE /sessions/:id",
      "correct": "PATCH /sessions/:id/archive",
      "note": "DELETE requires status 'completed'. Use archive endpoint for soft-archiving active sessions."
    },
    "ChatsAuth": {
      "note": "Chats controller extracts token from Authorization header manually — same Bearer format as all other routes. No special handling needed."
    },
    "SSE_Token": {
      "note": "Status and logs SSE streams require token as QUERY PARAM ?token=..., not Authorization header. Pass full localStorage.getItem('token') value."
    },
    "Groups_my": {
      "note": "GET /groups/my EXISTS. Returns groups where the current user is a member. Correct way to find student sessions."
    },
    "Forms_userSubmissions": {
      "note": "NO endpoint exists for a user to fetch their own form submissions. /forms/* routes are all quality+ only."
    },
    "Sessions_chatEndpoint": {
      "note": "NO /sessions/:id/chat endpoint exists. Session-level group chat is not implemented in the API. Use the /chats (direct message) system instead."
    },
    "ManageSession_overrideRank": {
      "wrong": "fetch .../override-rank with no body",
      "correct": "POST /sessions/:id/override-rank with body { tutorId: '<userId>' }"
    }
  }
