# ═══════════════════════════════════════════════════════════════════════════════
# .env.example - Template for deployment
# ═══════════════════════════════════════════════════════════════════════════════
#
# NEVER commit .env to git (it contains secrets)!
# Instead: copy this file and configure your own
#
#   For LOCAL testing:
#       Copy to: .env.local (used by docker-compose.local.yml)
#
#   For PRODUCTION:
#       Copy to: .env (used by docker-compose.yml)
#
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server Configuration ────────────────────────────────────────────────────
# ── Your server's IP or domain ────────────────────────────────────────────────
# VPN testing:    SERVER_HOST=26.64.216.17   (your Radmin/Hamachi VPN IP)
# LAN testing:    SERVER_HOST=192.168.1.34   (your local network IP)
# Production:     SERVER_HOST=your-domain.com
SERVER_HOST=26.64.216.17

# ── HTTPS ─────────────────────────────────────────────────────────────────────
# false = HTTP  (use for local/VPN testing — no cert needed)
# true  = HTTPS (requires a real domain + running init-ssl-cert.sh first)
USE_HTTPS=true

# ─── Ports ──────────────────────────────────────────────────────────────────
API_PORT_HTTP=4040
RTC_PORT_HTTP=5050
WEB_PORT_HTTP=4000

API_PORT_HTTPS=4043
RTC_PORT_HTTPS=5051
WEB_PORT_HTTPS=4004

# ─── Database (MongoDB) ─────────────────────────────────────────────────────
DB_NAME=P_01
DB_DRIVER=mongo
DB_URL=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0

# ─── JWT & Security ──────────────────────────────────────────────────────────
JWT_SECRET=Z3H@u8E#375Q[hKxAprDFGmERb05
SECRET=#K!x1$iSzC%Cs5uk:n7b8wcvM6pZlg6T.Uif9QBCIz2p7o3V:S!aMXEsDYtEG@BG
JWT_EXPIRES_IN=14400

# ─── RTC / TURN (for video conferencing) ────────────────────────────────────
STUN_URLS=stun:coturn:3478
TURN_URL=turn:coturn:3478
TURN_USERNAME=rtcuser
TURN_CREDENTIAL=changeme

# ─── Email (EmailJS) ────────────────────────────────────────────────────────
REACT_APP_EMAILJS_PUBLIC_KEY=Nvm4o7f3CGBjRYtZ5

# ─── Node Environment ──────────────────────────────────────────────────────
NODE_ENV=production
NODE_TLS_REJECT_UNAUTHORIZED=0

# ─── Frontend URLs (auto-computed from SERVER_HOST) ────────────────────────
REACT_APP_API_URL=https://26.64.216.17:4043/api
REACT_APP_RTC_URL=https://26.64.216.17:5051
REACT_APP_USE_HTTPS=true

# ─── Let's Encrypt (for automatic SSL renewal) ─────────────────────────────
# Email for certificate renewal notifications
ACME_EMAIL=mishanjalol666@gmail.com

ALLOWED_ORIGINS=*