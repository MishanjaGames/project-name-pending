# Your server's public IP or domain (no trailing slash, no protocol)
# Examples:  SERVER_HOST=192.168.1.100   or   SERVER_HOST=myapp.example.com
SERVER_HOST=192.168.0.36

# Protocol: true = HTTPS (self-signed cert), false = plain HTTP
USE_HTTPS=false

# ─── Ports ──────────────────────────────────────────────────────────────────
API_PORT_HTTP=4040
API_PORT_HTTPS=4043
RTC_PORT_HTTP=5050
RTC_PORT_HTTPS=5051
