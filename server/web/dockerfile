# ---- Build Stage ----
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first to leverage Docker layer caching
COPY package.json package-lock.json ./

RUN npm ci --silent

COPY . .

# Pass build-time env vars
ARG REACT_APP_API_URL
ARG REACT_APP_EMAILJS_PUBLIC_KEY
ARG REACT_APP_RTC_URL

ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_EMAILJS_PUBLIC_KEY=$REACT_APP_EMAILJS_PUBLIC_KEY
ENV REACT_APP_RTC_URL=$REACT_APP_RTC_URL

RUN npm run build

# ---- Serve Stage ----
FROM nginx:stable-alpine

# Install openssl to generate a self-signed cert for local/Docker use
RUN apk add --no-cache openssl

# Generate self-signed TLS certificate (valid 10 years)
# For production replace these files with real certs mounted via volume or secret
RUN mkdir -p /etc/nginx/certs && \
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
      -keyout /etc/nginx/certs/key.pem \
      -out    /etc/nginx/certs/cert.pem \
      -subj "/CN=localhost" \
      -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"

# Remove default nginx static files
RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/build /usr/share/nginx/html

# Custom nginx config — HTTPS on 443, redirect HTTP→HTTPS on 80
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
